# Discord Bot Token (Lấy từ Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Prefix dùng cho lệnh khẩn cấp nếu Slash Command chưa đồng bộ (ví dụ: ! hoặc ?)
BOT_PREFIX=!

# Danh sách Discord User ID của chủ sở hữu bot (cách nhau bởi dấu phẩy)
# Ví dụ: 123456789012345678,987654321098765432
# Chỉ những người này và Server Owner mới được phép thực hiện Backup & Restore
BOT_OWNER_IDS=

# Cấu hình tự động sao lưu định kỳ (True / False)
AUTO_BACKUP_ENABLED=False

# Khoảng thời gian tự động sao lưu (tính theo giờ)
AUTO_BACKUP_INTERVAL_HOURS=24

# Số lượng bản sao lưu tối đa giữ lại cho mỗi server (xóa bản cũ nhất khi vượt quá)
MAX_BACKUPS_PER_GUILD=10
